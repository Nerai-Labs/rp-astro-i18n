---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { useTranslations, ui } from '../../i18n/ui';

export function getStaticPaths() {
	return Object.keys(ui).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
const pages = {
  "en": {
    "title": "Plans | Autopilot",
    "description": "Plans: what it is and who it is for.",
    "h1": "Our plans",
    "html": "\u003ch2>Our plans?\u003c/h2>\u003cp>Plans for teams who want {more} & better.\u003c/p>\u003cul>\u003cli>One\u003c/li>\u003cli>Two\u003c/li>\u003c/ul>\n\u003ch2>FAQ\u003c/h2>\u003ch3>Why Plans?\u003c/h3>\u003cp>Because it's good.\u003c/p>",
    "schema": "{\"@graph\": [{\"name\": \"Plans\", \"@type\": \"WebPage\"}], \"@context\": \"https://schema.org\"}"
  },
  "es": {
    "title": "Planes | Autopilot",
    "description": "Planes: what it is and who it is for.",
    "h1": "Nuestros planes",
    "html": "\u003ch2>Nuestros planes?\u003c/h2>\u003cp>Planes for teams who want {more} & better.\u003c/p>\u003cul>\u003cli>One\u003c/li>\u003cli>Two\u003c/li>\u003c/ul>\n\u003ch2>FAQ\u003c/h2>\u003ch3>Why Planes?\u003c/h3>\u003cp>Because it's good.\u003c/p>",
    "schema": "{\"@graph\": [{\"name\": \"Planes\", \"@type\": \"WebPage\"}], \"@context\": \"https://schema.org\"}"
  }
};
const copy = pages[Astro.params.lang as keyof typeof pages];
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={copy.title} description={copy.description} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{copy.h1}</h1>
			<Fragment set:html={copy.html} />
			<script type="application/ld+json" set:html={copy.schema} />
		</main>
		<Footer />
	</body>
</html>
