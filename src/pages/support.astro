---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Support | Autopilot" description="Support: what it is and who it is for." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Get support</h1>
			<h2>Get support?</h2>
			<p>Support for teams who want &#123;more&#125; &amp; better.</p>
			<ul>
				<li>One</li>
				<li>Two</li>
			</ul>
			<h2>FAQ</h2>
			<h3>Why Support?</h3>
			<p>Because it&apos;s good.</p>
		</main>
		<Footer />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@graph": [
				{
					"name": "Support",
					"@type": "WebPage"
				}
			],
			"@context": "https://schema.org"
		})} />
	</body>
</html>
