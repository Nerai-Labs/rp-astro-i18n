---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { useTranslations, ui } from '../../i18n/ui';

export function getStaticPaths() {
	return Object.keys(ui).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={t('services.title')} description={t('services.description')} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{t('services.heading')}</h1>
			<h2>Autopilot section</h2>
			<p>A short section, with <a href="/x">a link</a> &amp; &#123;braces&#125;.</p>
			<p>{t('services.body')}</p>
		</main>
		<Footer />
		<script type="application/ld+json" set:html={JSON.stringify({
			"name": "Autopilot FAQ",
			"@type": "FAQPage",
			"@context": "https://schema.org",
			"mainEntity": []
		})} />
	</body>
</html>
